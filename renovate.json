{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 10am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 10am on monday"]
  },
  "packageRules": [
    {
      "description": "The Renovate of make renovate-check (.github/renovate-check): package.json, its lockfile and the Node.js its engines require move together",
      "matchFileNames": [".github/renovate-check/**"],
      "groupName": "Renovate validator",
      "automerge": false
    },
    {
      "description": "Go language dependencies update",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go major dependencies",
      "schedule": [
        "before 10am on the first day of the month"
      ]
    },
    {
      "description": "golang.org/x packages grouping",
      "matchDatasources": ["go"],
      "matchPackageNames": ["golang.org/x{/,}**"],
      "groupName": "golang.org/x packages",
      "automerge": false
    },
    {
      "description": "GitHub Actions update",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Security patches are provided immediately",
      "matchUpdateTypes": ["patch"],
      "matchDatasources": ["go"],
      "automerge": false,
      "minimumReleaseAge": null
    },
    {
      "description": "Vulnerable packages are given top priority",
      "matchDatasources": ["go"],
      "labels": ["security"],
      "prPriority": 10
    },
    {
      "description": "Hephaestus: the Action (SHA pin in the workflows) and the CLI version in the Makefile move together",
      "matchPackageNames": ["magicdrive/hephaestus", "github.com/magicdrive/hephaestus"],
      "groupName": "Hephaestus",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in the Makefile and the workflows, each marked with a `# renovate:` comment on the line above",
      "managerFilePatterns": ["/(^|/)Makefile$/", "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z_]+\\s*(\\?=|:=|=|:)\\s*\"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    }
  ],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 2,
  "ignorePaths": [
    "**/testdata/**",
    "**/*.golden"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "osvVulnerabilityAlerts": true
}
